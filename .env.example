# Build-time only. Never exposed to the browser, never committed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Canonical origin. LEAVE THIS UNSET rather than blank on Vercel — a variable
# that exists with an empty value used to break the build with
# "TypeError: Invalid URL ... input: ''". The app now falls back safely either
# way, but unset is still the cleaner configuration. A bare hostname works too.
NEXT_PUBLIC_SITE_URL=https://cleardaybaths.com

# Lead delivery
LEAD_TO_EMAIL=leads@cleardaybaths.com
LEAD_FROM_EMAIL=website@cleardaybaths.com
RESEND_API_KEY=
