# Build-time only. Never exposed to the browser, never committed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Canonical origin. LEAVE THIS UNSET rather than blank on Vercel — a variable
# that exists with an empty value used to break the build with
# "TypeError: Invalid URL ... input: ''". The app now falls back safely either
# way, but unset is still the cleaner configuration. A bare hostname works too.
NEXT_PUBLIC_SITE_URL=https://cleardaybaths.com

# Lead capture and notifications are handled by the existing CallRail script.
# No separate form-email credentials or recipient overrides are used.

# Live Google reviews (StatsRow + Testimonials + /reviews/). Both must be set
# or the site falls back to the static snapshot in data/reviews.json — never
# breaks, just stops updating. Refetched at most once an hour per Next's fetch
# cache, so this scales to every page that shows reviews without extra quota.
# Get the key from Google Cloud Console (enable "Places API (New)"); get the
# Place ID via Google's Place ID Finder using the business name + address.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Production only. Daily Slack notices after checking the canonical live article.
# Incoming webhook must be connected to the intended Clear Day Baths channel.
CRON_SECRET=
SLACK_PUBLISH_WEBHOOK_URL=
# Durable publication receipts (Upstash Redis REST / Vercel Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Upstash integration supplies these names; either naming pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
